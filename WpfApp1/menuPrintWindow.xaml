<Window
    x:Class="WpfApp1.menuPrintWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WpfApp1"
    xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Cafe# Отчёт меню"
    MinWidth="1200"
    MinHeight="1080"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <Style
            x:Key="reportHeader"
            BasedOn="{StaticResource menuText}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,20,0,10" />
        </Style>
        <Style
            x:Key="reportSubHeader"
            BasedOn="{StaticResource menuText}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="20,0,20,10" />
        </Style>


        <Style TargetType="DataGrid">
            <Setter Property="FontFamily" Value="Segoe UI, sans-serif" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#F9F9F9" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EEEEEE" />
            <Setter Property="VerticalGridLinesBrush" Value="#EEEEEE" />
            <Setter Property="RowHeaderWidth" Value="0" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F0F0F0" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <Border
            Grid.Row="0"
            Margin="5"
            Background="Gainsboro"
            CornerRadius="10">
            <Grid>
                <TextBlock
                    Margin="10"
                    HorizontalAlignment="Left"
                    FontSize="20"
                    Style="{StaticResource reportHeader}"
                    Text="Отчёт по популярности блюд" />
                <TextBlock
                    Name="reportDateTimeTextBlock"
                    Margin="10"
                    HorizontalAlignment="Right"
                    FontSize="20"
                    Style="{StaticResource reportSubHeader}" />
            </Grid>
        </Border>


        <StackPanel
            Grid.Row="2"
            Margin="0,10,0,10"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Label
                VerticalAlignment="Center"
                Content="С:"
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="#333333" />
            <DatePicker
                x:Name="StartDatePicker"
                Width="140"
                Height="35"
                FontSize="21" />
            <Label
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Content="По:"
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="#333333" />
            <DatePicker
                x:Name="EndDatePicker"
                Width="140"
                Height="35"
                FontSize="21" />
            <Button
                x:Name="RefreshButton"
                Margin="20,0,0,0"
                Click="RefreshButton_Click"
                Style="{StaticResource menuDialogButtonGreen}">
                <TextBlock
                    Margin="10,0,10,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource menuText}"
                    Text="Обновить отчёт" />
            </Button>
            <Button
                x:Name="ExportPdfButton"
                Margin="10,0,0,0"
                Click="ExportPdfButton_Click"
                Style="{StaticResource menuDialogButtonOrange}">
                <TextBlock
                    Margin="10,0,10,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource menuText}"
                    Text="Экспорт PDF" />
            </Button>
        </StackPanel>

        <Border
            Grid.Row="3"
            Margin="20,10,20,20"
            Padding="15"
            Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock
                        Margin="0,0,0,10"
                        HorizontalAlignment="Center"
                        FontSize="18"
                        Style="{StaticResource menuText}"
                        Text="Топ-10 самых популярных блюд" />
                    <lvc:CartesianChart Name="popularityChart" Height="300">
                        <lvc:CartesianChart.Series>
                            <lvc:ColumnSeries
                                Title="Количество заказов"
                                DataLabels="True"
                                Fill="#FFDA2D2D" />
                        </lvc:CartesianChart.Series>
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis
                                Name="popularityChartAxisX"
                                Title="Блюдо"
                                FontSize="12"
                                LabelsRotation="45">
                                <lvc:Axis.Separator>
                                    <lvc:Separator IsEnabled="False" Step="1" />
                                </lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis
                                Title="Количество заказов"
                                FontSize="12"
                                MinValue="0" />
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock
                        Margin="0,0,0,10"
                        HorizontalAlignment="Center"
                        FontSize="18"
                        Style="{StaticResource menuText}"
                        Text="Количество заказов по типам блюд" />
                    <lvc:CartesianChart Name="typesCartesianChart" Height="300">
                        <lvc:CartesianChart.Series>
                            <lvc:ColumnSeries
                                Title="Количество заказов"
                                DataLabels="True"
                                Fill="#FF98DE47" />
                        </lvc:CartesianChart.Series>
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis
                                Name="typesAxisX"
                                Title="Тип блюда"
                                FontSize="12"
                                LabelsRotation="45">
                                <lvc:Axis.Separator>
                                    <lvc:Separator IsEnabled="False" Step="1" />
                                </lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis
                                Title="Количество заказов"
                                FontSize="12"
                                MinValue="0" />
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </StackPanel>
            </Grid>
        </Border>

        <Border
            Grid.Row="4"
            Margin="20,0,20,20"
            Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            CornerRadius="10">
            <DataGrid
                Name="reportDataGrid"
                Margin="15"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="2*"
                        Binding="{Binding DishName}"
                        Header="Название блюда" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding DishType}"
                        Header="Тип" />
                    <DataGridTextColumn
                        Width="Auto"
                        Binding="{Binding Price, StringFormat='{}{0:F2} руб.'}"
                        Header="Цена" />
                    <DataGridTextColumn
                        Width="Auto"
                        Binding="{Binding Discount, StringFormat='{}{0}%'}"
                        Header="Скидка" />
                    <DataGridTextColumn
                        Width="Auto"
                        Binding="{Binding OrdersCount}"
                        Header="Кол-во заказов" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
