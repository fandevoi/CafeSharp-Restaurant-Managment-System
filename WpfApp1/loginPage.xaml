<Window
    x:Class="WpfApp1.loginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WpfApp1"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Cafe# Авторизация"
    Width="800"
    Height="485"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <StackPanel>
        <StackPanel Name="forgetStackPanel" Visibility="Collapsed">
            <Rectangle
                Width="800"
                Height="3"
                Fill="#FF755A4B"
                Stroke="#FF8A7253" />
            <Button
                Name="backButton"
                Width="30"
                Height="30"
                Margin="-730,10,0,0"
                Click="backButton_Click"
                Cursor="Hand"
                Style="{StaticResource loginButton}">
                <Icon:PackIconMaterial
                    Margin="6,0,0,0"
                    Kind="ArrowLeft"
                    Style="{StaticResource menuButtonIcon}" />
            </Button>
            <TextBlock
                Margin="0,80,0,10"
                FontSize="25"
                Style="{StaticResource menuText}"
                Text="Восстановление пароля"
                TextAlignment="Center" />
            <TextBox
                Name="recoveryTextBox"
                Width="265"
                Height="33"
                Margin="10"
                Padding="0,2,0,0"
                local:WatermarkService.Watermark="Введите код из письма"
                FontFamily="Fonts/#Inter Regular"
                FontSize="20"
                Style="{StaticResource roundedTextBox}" />
            <TextBox
                Name="recoveryTextBox2"
                Width="265"
                Height="33"
                Margin="10"
                Padding="0,2,0,0"
                local:WatermarkService.Watermark="Введите резервный код"
                FontFamily="Fonts/#Inter Regular"
                FontSize="20"
                Style="{StaticResource roundedTextBox}"
                Visibility="Collapsed" />
            <Button
                Name="noCodeButton"
                Width="120"
                Height="40"
                Padding="0"
                Background="{x:Null}"
                BorderBrush="{x:Null}"
                Click="noCodeButton_Click"
                Foreground="{x:Null}"
                Style="{StaticResource menuDialogButton}">
                <TextBlock
                    Margin="0,0,0,0"
                    FontSize="13"
                    Foreground="#FF5E68C6"
                    Style="{StaticResource menuText}"
                    Text="Не приходит код?"
                    TextAlignment="Center"
                    TextDecorations="Baseline" />
            </Button>
            <Button
                Name="recoveryButton"
                Width="170"
                Height="33"
                Margin="0,10,0,0"
                Click="recoveryButton_Click"
                Cursor="Hand"
                Style="{StaticResource loginButton}">
                <TextBlock
                    Margin="10,0,10,0"
                    Style="{StaticResource menuButtonText}"
                    Text="Проверить"
                    TextAlignment="Center" />
            </Button>
            <Button
                Name="recoveryButton2"
                Width="170"
                Height="33"
                Margin="0,10,0,0"
                Click="recoveryButton2_Click"
                Cursor="Hand"
                Style="{StaticResource loginButton}"
                Visibility="Collapsed">
                <TextBlock
                    Margin="10,0,10,0"
                    Style="{StaticResource menuButtonText}"
                    Text="Проверить"
                    TextAlignment="Center" />
            </Button>
            <Rectangle
                Width="800"
                Height="30"
                Margin="0,113,0,0"
                Fill="#FF755A4B"
                Stroke="#FF8A7253" />
            <TextBlock
                Width="220"
                Margin="20,-23,0,10"
                FontFamily="Fonts/#Inter Bold"
                FontSize="13"
                Foreground="White"
                Style="{StaticResource menuText}"
                Text="Поддержка: 8 (800) 944 27 49" />
        </StackPanel>
        <StackPanel Name="forgetSpareStackPanel" Visibility="Collapsed">
            <Image
                Width="220"
                Height="57"
                Source="/Images/applogo.png" />
            <Rectangle
                Width="800"
                Height="3"
                Fill="#FF755A4B"
                Stroke="#FF8A7253" />
            <Button
                Width="30"
                Height="30"
                Margin="-730,10,0,0"
                Click="backButton_Click"
                Cursor="Hand"
                Style="{StaticResource loginButton}">
                <Icon:PackIconMaterial
                    Margin="6,0,0,0"
                    Kind="ArrowLeft"
                    Style="{StaticResource menuButtonIcon}" />
            </Button>
            <TextBlock
                Margin="0,80,0,10"
                FontSize="25"
                Style="{StaticResource menuText}"
                Text="Восстановление пароля"
                TextAlignment="Center" />
            <TextBox
                Width="300"
                Height="33"
                Margin="10"
                Padding="0,2,0,0"
                local:WatermarkService.Watermark="Введите ваш резервный код"
                FontFamily="Fonts/#Inter Regular"
                FontSize="20"
                Style="{StaticResource roundedTextBox}" />
            <Button
                Width="170"
                Height="33"
                Margin="0,10,0,0"
                Click="loginButton_Click"
                Cursor="Hand"
                Style="{StaticResource loginButton}">
                <TextBlock
                    Margin="10,0,10,0"
                    Style="{StaticResource menuButtonText}"
                    Text="Отправить код"
                    TextAlignment="Center" />
            </Button>
            <Rectangle
                Width="800"
                Height="30"
                Margin="0,158,0,0"
                Fill="#FF755A4B"
                Stroke="#FF8A7253" />
            <TextBlock
                Width="220"
                Margin="20,-23,0,10"
                FontFamily="Fonts/#Inter Bold"
                FontSize="13"
                Foreground="White"
                Style="{StaticResource menuText}"
                Text="Поддержка: 8 (800) 944 27 49" />
        </StackPanel>
        <StackPanel Name="mainStackPanel" Visibility="Visible">
            <Rectangle
                Width="800"
                Height="3"
                Fill="#FF755A4B"
                Stroke="#FF755A4B" />

            <TextBlock
                Margin="0,80,0,10"
                FontSize="25"
                Style="{StaticResource menuText}"
                Text="Авторизация"
                TextAlignment="Center" />
            <TextBox
                Name="loginTextBox"
                Width="250"
                Height="33"
                Margin="10"
                Padding="0,2,0,0"
                local:WatermarkService.Watermark="Введите логин"
                FontFamily="Fonts/#Inter Regular"
                FontSize="20"
                Style="{StaticResource roundedTextBox}" />
            <TextBox
                Name="passwordTextBox"
                Width="250"
                Height="33"
                Margin="10"
                Padding="0,2,0,0"
                local:WatermarkService.Watermark="Какойтотекст"
                ContextMenu="{x:Null}"
                FontFamily="Fonts/#Password"
                FontSize="20"
                PreviewKeyDown="passwordTextBox_PreviewKeyDown"
                PreviewMouseLeftButtonDown="passwordTextBox_PreviewMouseLeftButtonDown"
                PreviewMouseRightButtonDown="passwordTextBox_PreviewMouseRightButtonDown"
                Style="{StaticResource roundedTextBox}" />
            <Button
                Name="forgetButton"
                Width="120"
                Height="40"
                Padding="0"
                Background="{x:Null}"
                BorderBrush="{x:Null}"
                Click="forgetButton_Click"
                Foreground="{x:Null}"
                Style="{StaticResource menuDialogButton}">
                <TextBlock
                    Margin="0,10,0,10"
                    FontSize="13"
                    Foreground="#FF5E68C6"
                    Style="{StaticResource menuText}"
                    Text="Забыли пароль?"
                    TextAlignment="Center"
                    TextDecorations="Baseline" />
            </Button>
            <Button
                Name="loginButton"
                Width="100"
                Height="33"
                Margin="0,10,0,0"
                Click="loginButton_Click"
                Cursor="Hand"
                Style="{StaticResource loginButton}">
                <TextBlock
                    Margin="10,0,10,0"
                    Style="{StaticResource menuButtonText}"
                    Text="Войти"
                    TextAlignment="Center" />
            </Button>
            <Rectangle
                Width="800"
                Height="30"
                Margin="0,100,0,0"
                Fill="#FF755A4B"
                Stroke="#FF8A7253" />
            <TextBlock
                Width="220"
                Margin="20,-23,0,10"
                FontFamily="Fonts/#Inter Bold"
                FontSize="13"
                Foreground="White"
                Style="{StaticResource menuText}"
                Text="Поддержка: 8 (800) 944 27 49" />

        </StackPanel>
    </StackPanel>

</Window>
