<Window
    x:Class="WpfApp1.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:converters="clr-namespace:WpfApp1.Services.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WpfApp1"
    xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:Sales_Dashboard.UserControls"
    Title="Cafe# Администратор"
    Width="1650"
    Height="780"
    MinWidth="1650"
    MinHeight="780"
    Background="Transparent"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Border
        Padding="20"
        Background="#FFECECF0"
        MouseDown="Border_MouseDown"
        MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="902*" />
                    <ColumnDefinition Width="11*" />
                    <ColumnDefinition Width="427*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="120" />
                    <RowDefinition Height="158" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Border
                    Grid.RowSpan="3"
                    Background="White"
                    CornerRadius="25">
                    <StackPanel>

                        <!--  Logo  -->
                        <Grid
                            Width="218"
                            Height="46"
                            Margin="0,10,0,10"
                            HorizontalAlignment="Center">
                            <TextBlock
                                Height="36"
                                Margin="0,14,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="23"
                                Style="{StaticResource menuText}"
                                Text="Администратор" />
                        </Grid>
                        <Rectangle
                            Width="223"
                            Height="3"
                            Fill="#FF8A7253"
                            Stroke="#FF8A7253" />
                        <!--  Menu Items  -->
                        <TextBlock
                            Foreground="Black"
                            Style="{StaticResource menuTitle}"
                            Text="Основное" />
                        <Button
                            Name="mainButton"
                            Click="mainButton_Click"
                            Style="{StaticResource menuButton}">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="Home" Style="{StaticResource menuButtonIcon}" />
                                <TextBlock Style="{StaticResource menuButtonText}" Text="Главная" />
                            </StackPanel>
                        </Button>

                        <Button
                            Name="menuButton"
                            Click="menuButton_Click"
                            Style="{StaticResource menuButton}">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="ClipboardTextPlayOutline" Style="{StaticResource menuButtonIcon}" />
                                <TextBlock Style="{StaticResource menuButtonText}" Text="Меню" />
                            </StackPanel>
                        </Button>

                        <Button
                            Name="tablesButton"
                            Click="tablesButton_Click"
                            Style="{StaticResource menuButton}">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="TableChair" Style="{StaticResource menuButtonIcon}" />
                                <TextBlock Style="{StaticResource menuButtonText}" Text="Столики" />
                            </StackPanel>
                        </Button>

                        <Button
                            Name="analyticsButton"
                            Click="analyticsButton_Click"
                            Style="{StaticResource menuButton}">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="Poll" Style="{StaticResource menuButtonIcon}" />
                                <TextBlock Style="{StaticResource menuButtonText}" Text="Аналитика" />
                            </StackPanel>
                        </Button>
                        <Button
                            Name="PersonalButton"
                            Click="PersonalButton_Click"
                            Style="{StaticResource menuButton}">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial
                                    Width="20"
                                    Height="20"
                                    Kind="AccountGroup"
                                    Style="{StaticResource menuButtonIcon}" />
                                <TextBlock Style="{StaticResource menuButtonText}" Text="Персонал" />
                            </StackPanel>
                        </Button>
                        <TextBlock
                            Foreground="Black"
                            Style="{StaticResource menuTitle}"
                            Text="Помощь" />

                        <Button
                            Name="infoButton"
                            Click="infoButton_Click"
                            Style="{StaticResource menuButton}">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="InformationOutline" Style="{StaticResource menuButtonIcon}" />
                                <TextBlock Style="{StaticResource menuButtonText}" Text="Информация" />
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </Border>
                <Border
                    Name="mainTopBorder"
                    Grid.Column="1"
                    Grid.ColumnSpan="3"
                    Margin="20,0,0,26"
                    Style="{StaticResource whiteBorder}"
                    Visibility="Visible">
                    <Grid>
                        <StackPanel
                            Name="mainHiBorder"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="26"
                                    FontWeight="Bold"
                                    Style="{StaticResource titleText}"
                                    Text="Добро пожаловать!" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    Foreground="#6C879A"
                                    Text="Хорошего дня!" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel
                            Name="mainTop"
                            Width="833"
                            Margin="-200,0,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                            <TextBlock
                                Height="19"
                                Margin="0,-4,0,0"
                                Style="{StaticResource menuText}"
                                Text="Активных заказов" />
                            <Border
                                Width="65"
                                Height="30"
                                Margin="5,0,20,0"
                                Background="#A0E182"
                                CornerRadius="10">
                                <TextBlock
                                    Name="ActiveOrders"
                                    Margin="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    Style="{StaticResource menuText}"
                                    Text="0" />
                            </Border>
                            <TextBlock
                                Height="19"
                                Margin="20,0,0,0"
                                Style="{StaticResource menuText}"
                                Text="Заказов за сегодня" />
                            <Border
                                Width="65"
                                Height="30"
                                Margin="10,0,0,0"
                                Background="#FFEFEFEF"
                                CornerRadius="10">
                                <TextBlock
                                    Name="TodayOrders"
                                    Margin="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    Style="{StaticResource menuText}"
                                    Text="0" />
                            </Border>
                            <TextBlock
                                Height="19"
                                Margin="40,0,0,0"
                                Style="{StaticResource menuText}"
                                Text="Отменённых заказов" />
                            <Border
                                Width="65"
                                Height="30"
                                Margin="10,0,0,0"
                                Background="#FFE8A45F"
                                CornerRadius="10">
                                <TextBlock
                                    Name="CancelledOrders"
                                    Margin="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    Style="{StaticResource menuText}"
                                    Text="0" />
                            </Border>
                        </StackPanel>
                        <StackPanel
                            Name="menuTopBorder"
                            Width="1279"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                            <TextBlock
                                Height="36"
                                Margin="0,0,0,0"
                                FontSize="30"
                                Style="{StaticResource menuText}"
                                Text="Редактирование меню" />
                            <Button
                                Name="menuResetButton"
                                Width="30"
                                Height="30"
                                Margin="20,4,0,0"
                                Click="menuResetButton_Click"
                                Cursor="Hand"
                                Style="{StaticResource menuButton}">
                                <Icon:PackIconMaterial
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Center"
                                    Kind="Refresh"
                                    Style="{StaticResource menuButtonIcon}" />
                            </Button>
                            <ComboBox
                                x:Name="MenuCategoryComboBox"
                                Width="300"
                                Margin="10,0,0,0"
                                FontFamily="Fonts/#Inter Medium"
                                FontSize="15"
                                SelectionChanged="MenuCategoryComboBox_SelectionChanged" />
                            <Button
                                Name="printButton"
                                Width="40"
                                Height="26"
                                Margin="10,5,0,0"
                                HorizontalAlignment="Right"
                                Click="printButton_Click"
                                Style="{StaticResource menuButton}">
                                <Icon:PackIconMaterial
                                    Width="20"
                                    Height="26"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Kind="Printer"
                                    Style="{StaticResource menuButtonIcon}" />
                            </Button>
                            <Button
                                Name="AddDishButton"
                                Width="40"
                                Height="26"
                                Margin="10,5,0,0"
                                HorizontalAlignment="Right"
                                Click="AddDishButton_Click"
                                Style="{StaticResource menuButton}">
                                <Icon:PackIconMaterial
                                    Width="20"
                                    Height="26"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Kind="Plus"
                                    Style="{StaticResource menuButtonIcon}" />
                            </Button>
                            <Button
                                Name="AddOptionButton"
                                Width="130"
                                Height="30"
                                Margin="10,5,0,0"
                                Padding="0"
                                HorizontalAlignment="Right"
                                Click="AddOptionButton_Click"
                                Style="{StaticResource menuButton}">
                                <TextBlock
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="20"
                                    Style="{StaticResource menuText}"
                                    Text="Топпинги" />
                            </Button>
                            <Button
                                Name="ToStopListButton"
                                Width="130"
                                Height="30"
                                Margin="10,5,0,0"
                                Padding="0"
                                HorizontalAlignment="Right"
                                Style="{StaticResource menuButton}" Click="ToStopListButton_Click">
                                <TextBlock
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="20"
                                    Style="{StaticResource menuText}"
                                    Text="Стоп лист" />
                            </Button>
                        </StackPanel>
                        <StackPanel
                            Name="analyticsTopBorder"
                            Width="1279"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                            <TextBlock
                                Height="36"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Left"
                                FontSize="30"
                                Style="{StaticResource menuText}"
                                Text="Сводка" />
                            <Button
                                Name="analyticsDayButton"
                                Width="100"
                                Height="30"
                                Margin="5,4,0,0"
                                Click="analyticsDayButton_Click"
                                Cursor="Hand"
                                Style="{StaticResource menuButton}">
                                <TextBlock
                                    Margin="10,0,10,0"
                                    Style="{StaticResource menuButtonText}"
                                    Text="День"
                                    TextAlignment="Center" />
                            </Button>
                            <Button
                                Name="analyticsWeekButton"
                                Width="100"
                                Height="30"
                                Margin="5,4,0,0"
                                Click="analyticsWeekButton_Click"
                                Cursor="Hand"
                                Style="{StaticResource menuButton}">
                                <TextBlock
                                    Margin="10,0,10,0"
                                    Style="{StaticResource menuButtonText}"
                                    Text="Неделя"
                                    TextAlignment="Center" />
                            </Button>
                            <Button
                                Name="analyticsMonthButton"
                                Width="100"
                                Height="30"
                                Margin="5,4,0,0"
                                Click="analyticsMonthButton_Click"
                                Cursor="Hand"
                                Style="{StaticResource menuButton}">
                                <TextBlock
                                    Margin="10,0,10,0"
                                    Style="{StaticResource menuButtonText}"
                                    Text="Месяц"
                                    TextAlignment="Center" />
                            </Button>
                            <Button
                                Name="analyticsQuarterButton"
                                Width="100"
                                Height="30"
                                Margin="5,4,0,0"
                                Click="analyticsQuarterButton_Click"
                                Cursor="Hand"
                                Style="{StaticResource menuButton}">
                                <TextBlock
                                    Margin="10,0,10,0"
                                    Style="{StaticResource menuButtonText}"
                                    Text="Квартал"
                                    TextAlignment="Center" />
                            </Button>
                        </StackPanel>
                        <StackPanel
                            Name="tablesBorder"
                            Width="1279"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                            <TextBlock
                                Height="21"
                                Margin="40,1,0,0"
                                Style="{StaticResource menuText}"
                                Text="Свободных столиков" />
                            <Border
                                Width="65"
                                Height="30"
                                Margin="5,4,20,0"
                                Background="#A0E182"
                                CornerRadius="10">
                                <TextBlock
                                    Name="tablesFreeTables"
                                    Margin="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    Style="{StaticResource menuText}" />
                            </Border>
                            <TextBlock
                                Height="22"
                                Margin="40,1,0,0"
                                Style="{StaticResource menuText}"
                                Text="Активные брони" />
                            <Border
                                Width="65"
                                Height="30"
                                Margin="5,4,20,0"
                                Background="#FFE8A45F"
                                CornerRadius="10">
                                <TextBlock
                                    Name="tablesActiveReservations"
                                    Margin="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    Style="{StaticResource menuText}" />
                            </Border>
                            <TextBlock
                                Height="19"
                                Margin="40,0,0,0"
                                Style="{StaticResource menuText}"
                                Text="Занятых столиков" />
                            <Border
                                Width="65"
                                Height="30"
                                Margin="5,4,20,0"
                                Background="#FFE85959"
                                CornerRadius="10">
                                <TextBlock
                                    Name="tablesBusyTables"
                                    Margin="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    Style="{StaticResource menuText}" />
                            </Border>

                            <Button
                                Width="310"
                                Height="29"
                                Margin="20,5,0,0"
                                Click="Button_Click"
                                Style="{StaticResource menuButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial
                                        Width="20"
                                        Height="26"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Kind="CalendarMonth"
                                        Style="{StaticResource menuButtonIcon}" />
                                    <TextBlock
                                        Height="22"
                                        Style="{StaticResource menuButtonText}"
                                        Text="Управление бронированием"
                                        TextAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel
                            Name="infoBorder"
                            Width="1279"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                            <TextBlock
                                Height="31"
                                Margin="470,1,0,0"
                                FontSize="25"
                                Style="{StaticResource menuText}"
                                Text="Информация о программе" />
                        </StackPanel>
                        <StackPanel
                            Name="garconsTopBorder"
                            Width="1279"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                            <TextBlock
                                Height="36"
                                Margin="0,0,0,0"
                                FontSize="30"
                                Style="{StaticResource menuText}"
                                Text="Управление персоналом" />

                        </StackPanel>
                    </Grid>
                </Border>
                <!--  Main  -->
                <Grid
                    Name="mainDishBorder"
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="3"
                    Margin="10,-10,10,0"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="487*" />
                        <ColumnDefinition Width="408*" />
                        <ColumnDefinition Width="425*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="1"
                        Margin="10,0,3,0"
                        Style="{StaticResource whiteBorder}">
                        <Grid>
                            <TextBlock
                                Margin="0,-15,0,0"
                                FontSize="16"
                                Style="{StaticResource menuText}"
                                Text="Объём продаж в этом месяце" />
                            <TextBlock
                                Margin="0,5,0,0"
                                FontSize="13"
                                Style="{StaticResource menuText}"
                                Text="{Binding MonthSells}" />
                            <lvc:CartesianChart
                                Name="TestChart"
                                Margin="0,19,0,-14"
                                LegendLocation="None">


                                <lvc:CartesianChart.Series>
                                    <lvc:LineSeries
                                        Title="За этот день: "
                                        Fill="#A0E182"
                                        PointGeometrySize="0"
                                        Stroke="#A0E182"
                                        StrokeThickness="3"
                                        Values="{Binding ChartValues}" />
                                </lvc:CartesianChart.Series>

                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis
                                        Title="Дата"
                                        Foreground="Black"
                                        Labels="{Binding Labels}"
                                        ShowLabels="True">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator Step="1" StrokeThickness="0" />
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisX>

                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis
                                        Title="Выручка руб."
                                        Foreground="Black"
                                        MaxValue="{Binding Max}"
                                        MinValue="0"
                                        ShowLabels="True">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator StrokeThickness="0" />
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisY>


                            </lvc:CartesianChart>

                        </Grid>

                    </Border>
                    <Border
                        Name="mainTopDish"
                        Grid.Column="0"
                        Margin="10,0,3,0"
                        Style="{StaticResource whiteBorder}"
                        Visibility="Collapsed">
                        <!--  Chart  -->
                        <Grid Margin="-15,-10,-5,-10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="146*" />
                                <ColumnDefinition Width="10*" />
                                <ColumnDefinition Width="303*" />
                            </Grid.ColumnDefinitions>
                            <Image
                                Name="topDishImageControl"
                                Grid.Column="0"
                                Margin="7"
                                Source="{Binding Image}"
                                Stretch="UniformToFill" />

                            <TextBlock
                                Grid.Column="2"
                                Width="198"
                                Margin="1,39,0,71"
                                HorizontalAlignment="Left"
                                FontFamily="Fonts/#Inter Medium"
                                FontSize="17"
                                Style="{StaticResource menuText}"
                                Text="Блюдо месяца" />
                            <TextBlock
                                Grid.Column="2"
                                Width="284"
                                Margin="1,10,0,100"
                                HorizontalAlignment="Left"
                                FontSize="24"
                                Style="{StaticResource menuText}"
                                Text="{Binding Dish}" />
                            <TextBlock
                                Grid.Column="2"
                                Width="98"
                                Margin="1,123,0,0"
                                HorizontalAlignment="Left"
                                FontFamily="Fonts/#Inter Medium"
                                FontSize="16"
                                Style="{StaticResource menuText}"
                                Text="{Binding OrdersCount}" />
                        </Grid>

                    </Border>
                    <Border
                        Grid.Column="2"
                        Margin="10,0,-12,0"
                        Style="{StaticResource whiteBorder}">
                        <!--  Chart  -->
                        <Grid>
                            <TextBlock
                                Margin="0,-15,0,0"
                                FontSize="16"
                                Style="{StaticResource menuText}"
                                Text="Заказы за месяц" />
                            <TextBlock
                                Margin="0,5,0,0"
                                FontSize="13"
                                Style="{StaticResource menuText}"
                                Text="{Binding MonthOrdersCount}" />
                            <lvc:CartesianChart Margin="0,19,0,-14" LegendLocation="None">

                                <lvc:CartesianChart.Series>
                                    <lvc:LineSeries
                                        Title="За этот день: "
                                        Fill="#FFE8A45F"
                                        PointGeometrySize="0"
                                        Stroke="#FFE8A45F"
                                        StrokeThickness="3"
                                        Values="{Binding MonthOrdersChartValues}" />
                                </lvc:CartesianChart.Series>

                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis
                                        Title="Дата"
                                        Foreground="Black"
                                        Labels="{Binding Labels3}"
                                        ShowLabels="True">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator Step="1" StrokeThickness="0" />
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisX>

                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis
                                        Title="Кол.во заказов"
                                        Foreground="Black"
                                        MaxValue="{Binding MonthOrdersMax}"
                                        MinValue="0"
                                        ShowLabels="True">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator StrokeThickness="0" />
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisY>


                            </lvc:CartesianChart>

                        </Grid>

                    </Border>
                </Grid>
                <Border
                    Name="main3Border"
                    Grid.Row="2"
                    Grid.Column="1"
                    Grid.ColumnSpan="3"
                    Margin="20,10,0,0"
                    Style="{StaticResource whiteBorder}"
                    Visibility="Collapsed">
                    <Grid Margin="10,5">
                        <TextBlock
                            Foreground="Black"
                            Style="{StaticResource titleText}"
                            Text="Продажи за 3 последних месяца" />
                        <uc:Legends
                            Margin="0,8,10,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            FirstMonth="{Binding FirstMonthText}"
                            SecondMonth="{Binding SecondMonthText}"
                            ThirdMonth="{Binding ThirdMonthText}" />
                        <lvc:CartesianChart Margin="5,40,0,23" LegendLocation="None">

                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis
                                    Title="Дата"
                                    Foreground="Black"
                                    Labels="{Binding Labels2}"
                                    ShowLabels="True">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator Step="1" StrokeThickness="0" />
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisX>

                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis
                                    Title="Выручка руб."
                                    Foreground="Black"
                                    MaxValue="{Binding Max2Value}"
                                    MinValue="0"
                                    ShowLabels="True">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator StrokeThickness="0" />
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisY>

                            <lvc:CartesianChart.Series>

                                <lvc:LineSeries
                                    Title="За этот день: "
                                    Fill="#FFBFF9A0"
                                    PointGeometrySize="0"
                                    Stroke="#FFBFF9A0"
                                    StrokeThickness="3"
                                    Values="{Binding ThirdMonthValues}" />
                                <lvc:LineSeries
                                    Title="За этот день: "
                                    Fill="#FFE49762"
                                    PointGeometrySize="0"
                                    Stroke="#FFE49762"
                                    StrokeThickness="3"
                                    Values="{Binding SecondMonthValues}" />
                                <lvc:LineSeries
                                    Title="За этот день: "
                                    Fill="#FF81E098"
                                    PointGeometrySize="0"
                                    Stroke="#FF81E098"
                                    StrokeThickness="3"
                                    Values="{Binding FirstMonthValues}" />
                            </lvc:CartesianChart.Series>
                        </lvc:CartesianChart>

                        <Grid Margin="10,0,0,0" VerticalAlignment="Bottom">
                            <Icon:PackIconMaterial Foreground="#FF81E098" Kind="Information" />
                            <TextBlock
                                Margin="30,0,0,0"
                                Foreground="{StaticResource GreyColor}"
                                LineHeight="18"
                                Text="Статистика продаж по дням за последние 3 календарных месяца"
                                TextWrapping="Wrap" />
                        </Grid>

                    </Grid>
                </Border>
                <!--  Menu  -->
                <Grid
                    Name="menuGrid"
                    Grid.Row="1"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    Grid.ColumnSpan="3"
                    Margin="20,-10,0,0"
                    Visibility="Collapsed">
                    <ListView
                        Name="menuListView"
                        Margin="0"
                        HorizontalContentAlignment="Center"
                        Background="Transparent"
                        BorderBrush="{x:Null}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectionChanged="menuListView_SelectionChanged"
                        Visibility="Visible">

