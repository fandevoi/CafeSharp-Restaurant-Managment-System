<Window
    x:Class="WpfApp1.menuEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WpfApp1"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Cafe# Меню"
    Width="650"
    Height="1000"
    MinWidth="650"
    MinHeight="545"
    Cursor=""
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Border
        Grid.Row="1"
        Padding="30"
        Background="White"
        BorderBrush="#FFECECF0"
        BorderThickness="1"
        CornerRadius="10"
        Effect="{StaticResource MaterialDesignShadowDepth2}"
        MouseDown="Border_MouseDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Name="Title"
                Grid.Row="0"
                Margin="0,0,0,10"
                HorizontalAlignment="Center"
                FontSize="30"
                FontWeight="SemiBold"
                Style="{StaticResource menuText}"
                Text="Создать блюдо" />

            <Grid Grid.Row="1" Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="200"
                    Height="200"
                    HorizontalAlignment="Center"
                    BorderBrush="#FFECECF0"
                    BorderThickness="1"
                    SnapsToDevicePixels="True">
                    <Image
                        x:Name="dishImage"
                        Source="{Binding Image}"
                        Stretch="UniformToFill" />
                </Border>

                <Button
                    Name="selectImageButton"
                    Grid.Column="1"
                    Width="280"
                    Height="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Click="SelectImage_Click"
                    Style="{StaticResource menuDialogButton}">
                    <TextBlock
                        Margin="0"
                        FontSize="14"
                        Style="{StaticResource menuButtonText}"
                        Text="Выбрать изображение"
                        TextAlignment="Center" />
                </Button>
            </Grid>

            <TextBlock
                Grid.Row="2"
                Margin="0,0,0,5"
                HorizontalAlignment="Left"
                FontSize="18"
                FontWeight="Medium"
                Style="{StaticResource menuText}"
                Text="Наименование блюда" />
            <TextBox
                Name="nameTextBlock"
                Grid.Row="3"
                Width="Auto"
                Height="40"
                Margin="0,0,0,22"
                HorizontalAlignment="Stretch"
                FontFamily="Fonts/#Inter Regular"
                FontSize="22"
                Style="{StaticResource roundedTextBox}"
                Text="{Binding Menu_Name}" />

            <TextBlock
                Grid.Row="4"
                Margin="0,0,0,5"
                HorizontalAlignment="Left"
                FontSize="18"
                FontWeight="Medium"
                Style="{StaticResource menuText}"
                Text="Вид блюда" />
            <ComboBox
                Name="typeComboBox"
                Grid.Row="5"
                Width="Auto"
                Height="40"
                Margin="0,0,0,20"
                HorizontalAlignment="Stretch"
                FontFamily="Fonts/#Inter Regular"
                FontSize="22"
                SelectedItem="{Binding Menu_Type}"
                Style="{StaticResource roundedComboBox}" />

            <Grid Grid.Row="6" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,0,5"
                    HorizontalAlignment="Left"
                    FontSize="18"
                    FontWeight="Medium"
                    Style="{StaticResource menuText}"
                    Text="Цена" />
                <TextBox
                    Name="priceTextBlock"
                    Grid.Row="1"
                    Grid.Column="0"
                    Width="Auto"
                    Height="40"
                    Margin="0,0,10,0"
                    HorizontalAlignment="Stretch"
                    FontFamily="Fonts/#Inter Regular"
                    FontSize="22"
                    Style="{StaticResource roundedTextBox}"
                    Text="{Binding Menu_Price}" />

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="10,0,0,5"
                    HorizontalAlignment="Left"
                    FontSize="18"
                    FontWeight="Medium"
                    Style="{StaticResource menuText}"
                    Text="Скидка (%)" />
                <TextBox
                    Name="discountTextBox"
                    Grid.Row="1"
                    Grid.Column="1"
                    Width="Auto"
                    Height="40"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Stretch"
                    FontFamily="Fonts/#Inter Regular"
                    FontSize="22"
                    Style="{StaticResource roundedTextBox}"
                    Text="{Binding Menu_Discount}" />
            </Grid>

            <StackPanel
                Grid.Row="5"
                Margin="0,0,22,20"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="Medium"
                    Style="{StaticResource menuText}"
                    Text="Напиток" />
                <Border
                    Padding="5"
                    Background="Gainsboro"
                    CornerRadius="5">
                    <CheckBox Name="isBarCheckBox" IsChecked="{Binding IsBar}">
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="1.4" ScaleY="1.4" />
                        </CheckBox.LayoutTransform>
                    </CheckBox>
                </Border>
            </StackPanel>


            <TextBlock
                Grid.Row="7"
                Height="26"
                Margin="0,0,0,10"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                FontSize="18"
                FontWeight="Medium"
                Style="{StaticResource menuText}"
                Text="Топпинги:" />
            <ListBox
                Name="selectedToppingsListBox"
                Grid.Row="8"
                MaxHeight="200"
                Margin="0,0,0,20"
                HorizontalContentAlignment="Stretch"
                BorderBrush="#FFECECF0"
                BorderThickness="1"
                Foreground="#E5000000"
                ItemsSource="{Binding SelectedDishOptions}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Margin="5,2"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Text="{Binding Option_Name}" />
                            <Button
                                Name="RemoveToppingButton"
                                Grid.Column="1"
                                Width="36"
                                Height="36"
                                Click="RemoveTopping_Click"
                                Style="{StaticResource menuDialogButtonOrange}"
                                Tag="{Binding Option_ID}"
                                ToolTip="Удалить топпинг">
                                <Icon:PackIconMaterial
                                    Margin="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Kind="TrashCan"
                                    Style="{StaticResource menuButtonIcon}" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel
                Grid.Row="9"
                Margin="0,0,0,30"
                HorizontalAlignment="Left"
                Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,15,0"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Style="{StaticResource menuText}"
                    Text="Добавить топпинг:" />
                <ComboBox
                    Name="availableToppingsComboBox"
                    Width="200"
                    Height="40"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    DisplayMemberPath="Option_Name"
                    FontFamily="Fonts/#Inter Regular"
                    FontSize="22"
                    ItemsSource="{Binding AvailableOptions}"
                    SelectedValuePath="Option_ID"
                    Style="{StaticResource roundedComboBox}" />
                <Button
                    Name="addToppingButton"
                    Height="40"
                    Margin="15,0,0,0"
                    VerticalAlignment="Center"
                    Click="AddTopping_Click"
                    Style="{StaticResource menuDialogButton}">
                    <TextBlock
                        Margin="15,0,15,0"
                        Style="{StaticResource menuButtonText}"
                        Text="Добавить"
                        TextAlignment="Center" />
                </Button>
            </StackPanel>

            <Grid
                Grid.Row="11"
                Margin="0,0,30,0"
                HorizontalAlignment="Center">

                <Button
                    Name="saveButton"
                    Grid.Column="0"
                    Width="300"
                    Height="45"
                    Click="saveButton_Click"
                    Cursor="Hand"
                    Style="{StaticResource menuDialogButtonGreen}">
                    <TextBlock
                        Margin="10,0,10,0"
                        Style="{StaticResource menuButtonText}"
                        Text="Сохранить"
                        TextAlignment="Center" />
                </Button>
                <Button
                    Name="deleteButton"
                    Grid.Column="1"
                    Width="45"
                    Height="45"
                    Margin="360,-5,0,0"
                    Click="deleteButton_Click"
                    Cursor="Hand"
                    Style="{StaticResource menuDialogButtonOrange}"
                    ToolTip="Удалить блюдо">
                    <Icon:PackIconMaterial
                        Margin="0"
                        HorizontalAlignment="Center"
                        Kind="Delete"
                        Style="{StaticResource menuButtonIcon}" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
