<Window
    x:Class="WpfApp1.GarconWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:controls="clr-namespace:BlurryControls.Controls;assembly=BlurryControls"
    xmlns:converters="clr-namespace:WpfApp1.Services.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:WpfApp1"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:Sales_Dashboard.UserControls"
    Title="Cafe# Официанты"
    Width="1920"
    Height="1080"
    Background="Transparent"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid MouseDown="Border_MouseDown" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid x:Name="OuterBlurContainer">
            <Grid x:Name="InnerBlurContainer">
                <Grid.Background>
                    <ImageBrush ImageSource="/3968e6ce6271b21e633a5e6951295e61.jpg" />
                </Grid.Background>
            </Grid>
        </Grid>

        <TabControl Name="TabFather">
            <TabControl.ItemContainerStyle>
                <Style TargetType="{x:Type TabItem}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>
            <TabItem
                Name="DishesSelectorTab"
                Visibility="Collapsed">
                <Grid Margin="0,0,0,-22">


                    <Grid Name="PaymentTab" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <controls:BlurryUserControl
                            Grid.Column="0"
                            Margin="20,20,5,40"
                            Padding="0"
                            Panel.ZIndex="100"
                            Background="Transparent"
                            BlurContainer="{Binding ElementName=OuterBlurContainer}"
                            BlurRadius="55"
                            BorderBrush="#AF484848"
                            BorderThickness="3"
                            DragMoveEnabled="True"
                            Magnification="0.25"
                            Visibility="Visible">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*" />
                                    <RowDefinition Height="18*" />
                                </Grid.RowDefinitions>
                                <Border
                                    Grid.Row="0"
                                    Width="50"
                                    Margin="10,5,0,0"
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource blackBorder}">
                                    <Button
                                        Height="48"
                                        Padding="0"
                                        Background="{x:Null}"
                                        BorderBrush="{x:Null}"
                                        Click="BackToMenuButton_Click"
                                        Foreground="White">
                                        <Grid>
                                            <Icon:PackIconMaterial
                                                Width="25"
                                                Height="25"
                                                Margin="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Kind="ArrowLeft"
                                                Style="{StaticResource menuButtonIcon}" />
                                        </Grid>
                                    </Button>

                                </Border>
                                <Border
                                    Grid.Column="1"
                                    Margin="65,5,10,0"
                                    Padding="0"
                                    Style="{StaticResource blackBorder}">
                                    <Grid>
                                        <TextBlock
                                            Name="OrderInfoTextBlock"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontFamily="Fonts/#Inter Bold"
                                            FontSize="25"
                                            FontWeight="Bold"
                                            Text=" "
                                            TextAlignment="Center">
                                            <TextBlock.Foreground>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop Color="White" />
                                                    <GradientStop Offset="0.994" Color="#FFA4A4A4" />
                                                </LinearGradientBrush>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <ListView
                                    x:Name="GuestsListView"
                                    Grid.Row="1"
                                    Margin="10,3,10,10"
                                    BorderThickness="0"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto">

                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical" />
                                        </ItemsPanelTemplate>
                                    </ListView.ItemsPanel>
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Height="auto"
                                                Margin="0,5,0,0"
                                                Padding="10"
                                                HorizontalAlignment="Stretch"
                                                Background="#B6000000"
                                                BorderThickness="1"
                                                CornerRadius="15">
                                                <StackPanel Margin="5" Orientation="Vertical">
                                                    <TextBlock
                                                        FontFamily="Fonts/#Inter Bold"
                                                        FontSize="18"
                                                        FontWeight="Bold"
                                                        Foreground="White"
                                                        Text="{Binding GuestNumber, StringFormat={}Гость {0}}" />
                                                    <TextBlock
                                                        Margin="0,-20,0,0"
                                                        HorizontalAlignment="Right"
                                                        FontFamily="Fonts/#Inter Bold"
                                                        FontSize="18"
                                                        FontWeight="Bold"
                                                        Foreground="White"
                                                        Text="{Binding TotalPrice, StringFormat={}{0} ₽}" />
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                        <ItemsControl ItemsSource="{Binding Dishes}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Margin="0,5" Orientation="Vertical">
                                                                        <!--  Блюдо  -->
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock
                                                                                Width="180"
                                                                                FontFamily="Fonts/#Inter Regular"
                                                                                Foreground="White"
                                                                                Text="{Binding DishName}" />
                                                                            <TextBlock
                                                                                Width="70"
                                                                                FontFamily="Fonts/#Inter Regular"
                                                                                Foreground="White"
                                                                                Text="{Binding Count, StringFormat={}{0} шт}" />
                                                                            <TextBlock
                                                                                Width="70"
                                                                                FontFamily="Fonts/#Inter Regular"
                                                                                Foreground="White"
                                                                                Text="{Binding DishPrice, StringFormat={}{0} ₽}" />
                                                                        </StackPanel>

                                                                        <!--  Опции блюда  -->
                                                                        <ItemsControl ItemsSource="{Binding SelectedOptions}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <TextBlock
                                                                                        Margin="20,0,0,0"
                                                                                        FontFamily="Fonts/#Inter Regular"
                                                                                        FontSize="14"
                                                                                        FontStyle="Italic"
                                                                                        Foreground="LightGray"
                                                                                        Text="{Binding OptionName, StringFormat=• {0}}" />
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                    </ScrollViewer>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </controls:BlurryUserControl>
                        <controls:BlurryUserControl
                            Grid.Column="1"
                            Margin="5,20,20,40"
                            Padding="0"
                            Panel.ZIndex="100"
                            Background="Transparent"
                            BlurContainer="{Binding ElementName=OuterBlurContainer}"
                            BlurRadius="55"
                            BorderBrush="#AF484848"
                            BorderThickness="3"
                            DragMoveEnabled="True"
                            Magnification="0.25"
                            Visibility="Visible">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*" />
                                    <RowDefinition Height="18*" />
                                </Grid.RowDefinitions>
                                <Border
                                    Grid.Column="1"
                                    Margin="10,5,10,0"
                                    Padding="0"
                                    Style="{StaticResource blackBorder}">
                                    <Grid>
                                        <TextBlock
                                            Name="PaymentTotalPrice"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontFamily="Fonts/#Inter Bold"
                                            FontSize="30"
                                            FontWeight="Bold"
                                            Text="Итого к оплате"
                                            TextAlignment="Center">
                                            <TextBlock.Foreground>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop Color="White" />
                                                    <GradientStop Offset="0.994" Color="#FFA4A4A4" />
                                                </LinearGradientBrush>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                        <!--<TextBlock
                                            Margin="0,0,90,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontFamily="Fonts/#Inter Bold"
                                            FontSize="25"
                                            FontWeight="Bold"
                                            Text="50/50"
                                            TextAlignment="Center">
                                            <TextBlock.Foreground>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop Color="White" />
                                                    <GradientStop Offset="0.994" Color="#FFA4A4A4" />
                                                </LinearGradientBrush>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                        <Border
                                            Width="60"
                                            Height="28"
                                            Margin="0,0,20,0"
                                            Padding="0"
                                            HorizontalAlignment="Right"
                                            CornerRadius="15">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop Color="White" />
                                                    <GradientStop Offset="1" Color="#FFB1B1B1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <ToggleButton
                                                Width="45"
                                                HorizontalAlignment="Center"
                                                Checked="ShowOthersToggle_Checked"
                                                IsChecked="False"
                                                Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                Unchecked="ShowOthersToggle_Unchecked" />
                                        </Border>-->
                                    </Grid>


                                </Border>
                                <Border
                                    Grid.Row="1"
                                    Margin="10"
                                    Padding="0"
                                    Style="{StaticResource blackBorder}">
                                    <StackPanel Grid.Row="1">
                                        <TextBlock
                                            Margin="10"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="Fonts/#Inter Bold"
                                            FontSize="40"
                                            FontWeight="Bold"
                                            Text="Выберите способ оплаты"
                                            TextAlignment="Center">
                                            <TextBlock.Foreground>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop Color="White" />
                                                    <GradientStop Offset="0.994" Color="#FFA4A4A4" />
                                                </LinearGradientBrush>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                        <Button
                                            Name="PayWithCardButton"
                                            Width="500"
                                            Height="70"
                                            Margin="0,30,0,10"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Click="PayWithCardButton_Click"
                                            Style="{StaticResource paymentCardButton}">
                                            <Grid>
                                                <TextBlock
                                                    Margin="0,0,20,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="35"
                                                    Style="{StaticResource menuButtonText}"
                                                    Text="Картой" />
                                                <Icon:PackIconMaterial
                                                    Width="35"
                                                    Height="35"
                                                    Margin="0,0,150,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Kind="CreditCard"
                                                    Style="{StaticResource menuButtonIcon}" />
                                            </Grid>
                                        </Button>
                                        <Button
                                            Name="PayWithCashButton"
                                            Width="500"
                                            Height="70"
                                            Margin="0,0,0,10"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Click="PayWithCashButton_Click"
                                            Style="{StaticResource paymentCashButton}">
                                            <Grid>
                                                <TextBlock
                                                    Margin="0,0,25,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="35"
                                                    Style="{StaticResource menuButtonText}"
                                                    Text="Наличными" />
                                                <Icon:PackIconMaterial
                                                    Width="35"
                                                    Height="35"
                                                    Margin="0,0,120,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Kind="CashRegister"
                                                    Style="{StaticResource menuButtonIcon}" />
                                            </Grid>
                                        </Button>
                                        <Button
                                            Name="PayWithSBPButton"
                                            Width="500"
                                            Height="70"
                                            Margin="0,0,0,10"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Click="PayWithSBPButton_Click"
                                            Style="{StaticResource paymentSbpButton}">
                                            <Grid>
                                                <TextBlock
                                                    Margin="0,0,20,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="35"
                                                    Style="{StaticResource menuButtonText}"
                                                    Text="СБП" />
                                                <Icon:PackIconMaterial
                                                    Width="30"
                                                    Height="30"
                                                    Margin="0,0,183,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Kind="Qrcode"
                                                    Style="{StaticResource menuButtonIcon}" />
                                            </Grid>
                                        </Button>

                                    </StackPanel>
                                </Border>

                            </Grid>
                        </controls:BlurryUserControl>

                    </Grid>
                    <Border
                        Name="PaymentWait"
                        Width="700"
                        Height="500"
                        Padding="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#E5000000"
                        CornerRadius="20"
                        Style="{StaticResource blackBorder}"
                        Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*" />
                                <RowDefinition Height="4*" />
                                <RowDefinition Height="1*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Margin="10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                FontFamily="Segoe UI"
                                FontSize="40"
                                FontWeight="Bold"
                                Text="Ожидание оплаты"
                                TextAlignment="Center">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="White" />
                                        <GradientStop Offset="0.994" Color="#FFA4A4A4" />
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                            <Grid Grid.Row="1">
                                <Icon:PackIconMaterial
                                    Width="192"
                                    Height="150"
                                    Margin="0,42,0,0"
                                    HorizontalAlignment="Center"
                                    Kind="ContactlessPayment">
                                    <Icon:PackIconMaterial.Foreground>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="White" />
                                            <GradientStop Offset="0.994" Color="#FFA4A4A4" />
                                        </LinearGradientBrush>
                                    </Icon:PackIconMaterial.Foreground>
                                </Icon:PackIconMaterial>
                                <UniformGrid
                                    x:Name="DotGrid"
                                    Margin="0,100,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Columns="10"
                                    Rows="1">
                                    <!--  Десять точек  -->
                                    <Ellipse
                                        Name="Dot0"
                                        Width="10"
                                        Height="10"
                                        Margin="4"
                                        Fill="White"
                                        Opacity="0.2" />
                                    <Ellipse
                                        Name="Dot1"
                                        Width="10"
                                        Height="10"
                                        Margin="4"
                                        Fill="White"
                                        Opacity="0.2" />
                                    <Ellipse
                                        Name="Dot2"
                                        Width="10"
                                        Height="10"
                                        Margin="4"
                                        Fill="White"
                                        Opacity="0.2" />
                                    <Ellipse
                                        Name="Dot3"
                                        Width="10"
                                        Height="10"
                                        Margin="4"
                                        Fill="White"
                                        Opacity="0.2" />
                                    <Ellipse
                                        Name="Dot4"
                                        Width="10"
                                        Height="10"
                                        Margin="4"
                                        Fill="White"
                                        Opacity="0.2" />
                                    <Ellipse
                                        Name="Dot5"
                                        Width="10"
                                        Height="10"
                                        Margin="4"
                                        Fill="White"
                                        Opacity="0.2" />
                                    <Ellipse
                                        Name="Dot6"
                                        Width="10"
                                        Height="10"
                                        Margin="4"
                                        Fill="White"
                                        Opacity="0.2" />
                                    <Ellipse
                                        Name="Dot7"
                                        Width="10"
                                        Height="10"
                                        Margin="4"
                                        Fill="White"
                                        Opacity="0.2" />
                                    <Ellipse
                                        Name="Dot8"
                                        Width="10"
                                        Height="10"
                                        Margin="4"
                                        Fill="White"
                                        Opacity="0.2" />
                                    <Ellipse
                                        Name="Dot9"
                                        Width="10"
                                        Height="10"
                                        Margin="4"
                                        Fill="White"
                                        Opacity="0.2" />
                                </UniformGrid>
                            </Grid>
                            <Button
                                Name="CancelPaymentButton"
                                Grid.Row="2"
                                Width="200"
                                Height="60"
                                Margin="40,0,0,10"
                                Padding="0"
                                HorizontalAlignment="Left"
                                Background="#99B94A16"
                                BorderBrush="{x:Null}"
                                Click="CancelPaymentButton_Click"
                                Foreground="White"
                                Style="{StaticResource garconAddGuestButton}">
                                <TextBlock
                                    Margin="0,-3,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="30"
                                    FontWeight="Bold"
                                    Text="Отменить"
                                    TextAlignment="Center">
                                    <TextBlock.Foreground>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="White" />
                                            <GradientStop Offset="0.994" Color="#FFA4A4A4" />
                                        </LinearGradientBrush>
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </Button>
                            <Button
                                Name="PaymentSuccesfulButton"
                                Grid.Row="2"
                                Width="200"
                                Height="60"
                                Margin="0,0,40,10"
                                Padding="0"
                                HorizontalAlignment="Right"
                                Background="#9931B916"
                                BorderBrush="{x:Null}"
                                Click="PaymentSuccesfulButton_Click"
                                Foreground="White"
                                Style="{StaticResource garconAddGuestButton}">
                                <TextBlock
                                    Margin="0,-3,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="30"
                                    FontWeight="Bold"
                                    Text="Оплачено"
                                    TextAlignment="Center">
                                    <TextBlock.Foreground>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="White" />
                                            <GradientStop Offset="0.994" Color="#FFA4A4A4" />
                                        </LinearGradientBrush>
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </Button>
                        </Grid>
                    </Border>
                    <controls:BlurryUserControl
                        Name="DishCountGrid"
                        Grid.Column="2"
                        Margin="-20"
                        Padding="0"
                        Panel.ZIndex="100"
                        Background="Transparent"
                        BlurContainer="{Binding ElementName=OuterBlurContainer}"
                        BlurRadius="55"
                        BorderBrush="#AF484848"
                        BorderThickness="3"
                        DragMoveEnabled="True"
                        Magnification="0.25"
                        Visibility="Hidden">
                        <Grid>
                            <Border
                                Width="1200"
                                Height="421"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#B6000000"
                                Style="{StaticResource whiteBorder}">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,00,0,10"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        FontSize="40"
                                        Foreground="White"
                                        Style="{StaticResource menuText}"
                                        Text="Выберите количество порций" />
                                    <TextBox
                                        x:Name="countTextBox"
                                        Width="594"
                                        Height="60"
                                        HorizontalAlignment="Center"
                                        Background="Black"
                                        BorderBrush="Black"
                                        FontFamily="Fonts/#Inter Regular"
                                        FontSize="40"
                                        Foreground="White"
                                        PreviewKeyDown="InputTextBox_PreviewKeyDown"
                                        PreviewTextInput="InputTextBox_PreviewTextInput"
                                        Style="{StaticResource roundedTextBox}"
                                        TextAlignment="Center"
                                        TextChanged="InputTextBox_TextChanged" />
                                    <Button
                                        Name="clearDishCount"
                                        Width="60"
                                        Height="60"
                                        Margin="670,-60,0,10"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Click="clearDishCount_Click"
                                        Style="{StaticResource garconDeleteGuestButton}">
                                        <Grid Width="60" HorizontalAlignment="Left">
                                            <Icon:PackIconMaterial
                                                Width="45"
                                                Height="45"
                                                Margin="0,0,0,0"
                                                HorizontalAlignment="Center"
                                                Kind="KeyboardBackspace"
                                                Style="{StaticResource menuButtonIcon}" />
                                        </Grid>
                                    </Button>
                                    <Button
                                        Name="dishCountNextButton"
                                        Width="594"
                                        Height="70"
                                        Margin="0,0,0,10"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Click="dishCountNextButton_Click"
                                        Style="{StaticResource garconGreenButton}">
                                        <Grid>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="40"
                                                Style="{StaticResource menuButtonText}"
                                                Text="Далее" />
                                        </Grid>
                                    </Button>
                                    <StackPanel
                                        Margin="30"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Button
                                            Margin="5"
                                            Click="NumberButton_Click"
                                            Content="0"
                                            FontFamily="Inter"
                                            FontSize="45"
                                            Style="{StaticResource CircularButtonStyle}" />
                                        <Button
                                            Margin="5"
                                            Click="NumberButton_Click"
                                            Content="1"
                                            FontFamily="Inter"
                                            FontSize="45"
                                            Style="{StaticResource CircularButtonStyle}" />
                                        <Button
                                            Margin="5"
                                            Click="NumberButton_Click"
                                            Content="2"
                                            FontFamily="Inter"
                                            FontSize="45"
                                            Style="{StaticResource CircularButtonStyle}" />
                                        <Button
                                            Margin="5"
                                            Click="NumberButton_Click"
                                            Content="3"
                                            FontFamily="Inter"
                                            FontSize="45"
                                            Style="{StaticResource CircularButtonStyle}" />
                                        <Button
                                            Margin="5"
                                            Click="NumberButton_Click"
                                            Content="4"
                                            FontFamily="Inter"
                                            FontSize="45"
                                            Style="{StaticResource CircularButtonStyle}" />
                                        <Button
                                            Margin="5"
                                            Click="NumberButton_Click"
                                            Content="5"
                                            FontFamily="Inter"
                                            FontSize="45"
                                            Style="{StaticResource CircularButtonStyle}" />
                                        <Button
                                            Margin="5"
                                            Click="NumberButton_Click"
                                            Content="6"
                                            FontFamily="Inter"
                                            FontSize="45"
                                            Style="{StaticResource CircularButtonStyle}" />
                                        <Button
                                            Margin="5"
                                            Click="NumberButton_Click"
                                            Content="7"
                                            FontFamily="Inter"
                                            FontSize="45"
                                            Style="{StaticResource CircularButtonStyle}" />
                                        <Button
                                            Margin="5"
                                            Click="NumberButton_Click"
                                            Content="8"
                                            FontFamily="Inter"
                                            FontSize="45"
                                            Style="{StaticResource CircularButtonStyle}" />
                                        <Button
                                            Margin="5"
                                            Click="NumberButton_Click"
                                            Content="9"
                                            FontFamily="Inter"
                                            FontSize="45"
                                            Style="{StaticResource CircularButtonStyle}" />

                                    </StackPanel>
                                </StackPanel>


                            </Border>
                        </Grid>
                    </controls:BlurryUserControl>
                    <Grid x:Name="OrderGrid" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="489" />
                            <ColumnDefinition Width="987" />
                            <ColumnDefinition Width="396" />
                        </Grid.ColumnDefinitions>
                        <controls:BlurryUserControl
                            Grid.Column="2"
                            Margin="0,20,-33,40"
                            Padding="0"
                            Panel.ZIndex="100"
                            Background="Transparent"
                            BlurContainer="{Binding ElementName=OuterBlurContainer}"
                            BlurRadius="55"
                            BorderBrush="#AF484848"
                            BorderThickness="3"
                            DragMoveEnabled="True"
                            Magnification="0.25">
                            <Grid Grid.Column="2" VerticalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="0.6*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
