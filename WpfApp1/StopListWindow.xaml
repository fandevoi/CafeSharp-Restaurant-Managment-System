<Window
    x:Class="WpfApp1.StopListWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WpfApp1"
    xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Cafe# Стоп лист"
    Width="800"
    Height="550"
    MinWidth="800"
    MinHeight="500"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <local:BoolToTextConverter x:Key="BoolToTextConverter" />
        <local:BoolToIconConverter x:Key="BoolToIconConverter" />
        <local:BoolToStyleConverter x:Key="BoolToStyleConverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="7*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,10,0,0"
            HorizontalAlignment="Center"
            FontSize="30"
            Style="{StaticResource menuText}"
            Text="Управление стоп-листом блюд" />

        <Border
            Grid.Row="1"
            Margin="20,0,20,10"
            Background="White"
            BorderBrush="LightGray"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel>

                <ListBox
    Name="dishesListBox"
    Height="1080" Margin="10,0,10,10"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch" Foreground="#E5000000"
    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Text="{Binding Menu_Name}" Style="{StaticResource menuText}" />
                                <Button
                    Grid.Column="1"
                    Width="210"
                    Height="40"
                    HorizontalAlignment="Right" Click="ToggleStopList_Click"
                    Style="{Binding IsInStopList, Converter={StaticResource BoolToStyleConverter}}"
                    Tag="{Binding Menu_ID}">
                                    <StackPanel Orientation="Horizontal" Margin="10 0 0 0">
                                        <Icon:PackIconMaterial
                            Margin="0,0,5,0"
                            HorizontalAlignment="Center"
                            Kind="{Binding IsInStopList, Converter={StaticResource BoolToIconConverter}}"
                            Style="{StaticResource menuButtonIcon}" />
                                        <TextBlock Text="{Binding IsInStopList, Converter={StaticResource BoolToTextConverter}}" Style="{StaticResource menuText}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>
    </Grid>
</Window>
