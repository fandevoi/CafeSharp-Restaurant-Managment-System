<Window
    x:Class="WpfApp1.Report"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WpfApp1"
    xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Report"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,10"
            Orientation="Horizontal">
            <Label VerticalAlignment="Center" Content="С:" />
            <DatePicker x:Name="StartDatePicker" Width="120" />
            <Label
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Content="По:" />
            <DatePicker x:Name="EndDatePicker" Width="120" />
            <Button
                x:Name="RefreshButton"
                Margin="10,0,0,0"
                Click="RefreshButton_Click"
                Content="Обновить" />
        </StackPanel>

        <TextBlock
            Grid.Row="1"
            Margin="0,0,0,10"
            HorizontalAlignment="Center"
            FontSize="20"
            FontWeight="Bold"
            Text="ОТЧЕТ ПО ЗАКАЗАМ" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Margin="5"
                BorderBrush="LightGray"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        Margin="5"
                        FontWeight="SemiBold"
                        Text="Динамика Заказов (Всего/Отменено)" />
                    <lvc:CartesianChart
                        x:Name="OrdersTrendChart"
                        MinHeight="200"
                        LegendLocation="Bottom">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis x:Name="OrdersTrendChartXAxis" />
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="Количество заказов" />
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </StackPanel>
            </Border>

            <Border
                Grid.Column="1"
                Margin="5"
                BorderBrush="LightGray"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        Margin="5"
                        FontWeight="SemiBold"
                        Text="Динамика Ежемесячной Выручки" />
                    <lvc:CartesianChart
                        x:Name="RevenueTrendChart"
                        MinHeight="200"
                        LegendLocation="Bottom">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis x:Name="RevenueTrendChartXAxis" />
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis x:Name="RevenueTrendChartYAxis" Title="Выручка" />
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Margin="5"
                BorderBrush="LightGray"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        Margin="5"
                        FontWeight="SemiBold"
                        Text="Топ Популярных Блюд" />
                    <lvc:PieChart
                        x:Name="TopDishesChart"
                        MinHeight="200"
                        LegendLocation="Right" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="1"
                Margin="5"
                BorderBrush="LightGray"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        Margin="5"
                        FontWeight="SemiBold"
                        Text="Топ Популярных Напитков" />
                    <lvc:PieChart
                        x:Name="TopDrinksChart"
                        MinHeight="200"
                        LegendLocation="Right" />
                </StackPanel>
            </Border>
        </Grid>

        <Border
            Grid.Row="4"
            Margin="5"
            Padding="10"
            BorderBrush="LightGray"
            BorderThickness="1">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock FontWeight="SemiBold" Text="Сводка за выбранный период: " />
                <TextBlock Margin="10,0,0,0" Text="Всего заказов: " />
                <TextBlock
                    x:Name="KpiTotalOrdersText"
                    FontWeight="Bold"
                    Text="0" />
                <TextBlock Margin="10,0,0,0" Text="Отменено: " />
                <TextBlock
                    x:Name="KpiCanceledOrdersText"
                    FontWeight="Bold"
                    Text="0" />
                <TextBlock Margin="10,0,0,0" Text="Выручка: " />
                <TextBlock
                    x:Name="KpiTotalRevenueText"
                    FontWeight="Bold"
                    Text="0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
