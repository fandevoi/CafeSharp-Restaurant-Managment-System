                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="Background" Value="#FF555555" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding Dish_Status}" Value="Готовится">
                                                                                                <Setter Property="Background" Value="#FFD28F0E" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding Dish_Status}" Value="Готово">
                                                                                                <Setter Property="Background" Value="#FF388E3C" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding Dish_Status}" Value="Отменено">
                                                                                                <Setter Property="Background" Value="#FFD32F2F" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <TextBlock
                                                                                    FontSize="12"
                                                                                    FontWeight="Medium"
                                                                                    Foreground="White"
                                                                                    Text="{Binding Dish_Status}" />
                                                                            </Border>
                                                                        </Grid>

                                                                        <StackPanel
                                                                            x:Name="ButtonsPanel"
                                                                            Margin="0,10,0,0"
                                                                            Orientation="Horizontal"
                                                                            Visibility="Collapsed">
                                                                            <StackPanel.Resources>
                                                                                <Style TargetType="Button">
                                                                                    <Setter Property="Width" Value="Auto" />
                                                                                    <Setter Property="MinWidth" Value="90" />
                                                                                    <Setter Property="Margin" Value="0,0,10,0" />
                                                                                    <Setter Property="Padding" Value="10,5" />
                                                                                    <Setter Property="Background" Value="#FFB94A16" />
                                                                                    <Setter Property="Foreground" Value="White" />
                                                                                    <Setter Property="FontWeight" Value="Medium" />
                                                                                    <Setter Property="BorderThickness" Value="0" />
                                                                                    <Setter Property="Cursor" Value="Hand" />
                                                                                    <Setter Property="Template">
                                                                                        <Setter.Value>
                                                                                            <ControlTemplate TargetType="Button">
                                                                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                                </Border>
                                                                                            </ControlTemplate>
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                    <Style.Triggers>
                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                            <Setter Property="Background" Value="#FFD45F2A" />
                                                                                        </Trigger>
                                                                                        <Trigger Property="IsPressed" Value="True">
                                                                                            <Setter Property="Background" Value="#FF9E3B0D" />
                                                                                        </Trigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </StackPanel.Resources>
                                                                            <Button
                                                                                Height="30"
                                                                                Click="StatusButton_Click"
                                                                                Content="Готовится" />
                                                                            <Button Click="StatusButton_Click" Content="Готово" />
                                                                            <Button
                                                                                Background="#FF6B7280"
                                                                                Click="StatusButton_Click"
                                                                                Content="Отменить" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <Border
                                                        Height="1"
                                                        Margin="0,15,0,10"
                                                        Background="#FF4A4A4A" />

                                                    <TextBlock
                                                        HorizontalAlignment="Right"
                                                        FontSize="15"
                                                        FontStyle="Italic"
                                                        Foreground="#FFBBBBBB"
                                                        Text="{Binding Garcon_Name, StringFormat={}Официант: {0}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                    </controls:BlurryUserControl>
                </Grid>
            </TabItem>
            <TabItem
                Name="LoginTabItem"
                IsSelected="True"
                Visibility="Collapsed">
                <Grid Margin="0,0,0,-22">

                    <controls:BlurryUserControl
                        Margin="-20"
                        Panel.ZIndex="100"
                        Background="Transparent"
                        BlurContainer="{Binding ElementName=OuterBlurContainer}"
                        BlurRadius="55"
                        BorderBrush="#AF484848"
                        BorderThickness="3"
                        DragMoveEnabled="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                                <RowDefinition Height="12*" />
                            </Grid.RowDefinitions>
                            <Border
                                Grid.Column="0"
                                Width="500"
                                Height="600 "
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#B6000000"
                                Style="{StaticResource whiteBorder}">
