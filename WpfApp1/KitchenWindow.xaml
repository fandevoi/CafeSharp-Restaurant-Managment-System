                                            x:Name="PasswordBox"
                                            BorderBrush="#7FFFFFFF"
                                            FontSize="23"
                                            Foreground="White" />
                                    </StackPanel>

                                    <Grid Grid.Row="1" Margin="0,20,0,0">

                                        <UniformGrid
                                            Grid.Column="0"
