                                            <Button
                                                Width="140"
                                                Height="95"
                                                Click="NumPad_Click"
                                                Content="8"
                                                Style="{StaticResource CircularButtonStyle}" />
                                            <Button
                                                Width="140"
                                                Height="95"
                                                Click="NumPad_Click"
                                                Content="9"
                                                Style="{StaticResource CircularButtonStyle}" />
                                            <Button
                                                Width="140"
                                                Height="95"
                                                Click="NumPad_Click"
                                                Content="4"
                                                Style="{StaticResource CircularButtonStyle}" />
                                            <Button
                                                Width="140"
                                                Height="95"
                                                Click="NumPad_Click"
                                                Content="5"
                                                Style="{StaticResource CircularButtonStyle}" />
                                            <Button
                                                Width="140"
                                                Height="95"
                                                Click="NumPad_Click"
                                                Content="6"
                                                Style="{StaticResource CircularButtonStyle}" />
                                            <Button
                                                Width="140"
                                                Height="95"
                                                Click="NumPad_Click"
                                                Content="1"
                                                Style="{StaticResource CircularButtonStyle}" />
                                            <Button
                                                Width="140"
                                                Height="95"
                                                Click="NumPad_Click"
                                                Content="2"
                                                Style="{StaticResource CircularButtonStyle}" />
                                            <Button
                                                Width="140"
                                                Height="95"
                                                Click="NumPad_Click"
                                                Content="3"
                                                Style="{StaticResource CircularButtonStyle}" />
                                            <Button
                                                Width="140"
                                                Height="95"
                                                Click="NumPad_Click"
                                                Content="0"
                                                Style="{StaticResource CircularButtonStyle}" />
                                            <Button
                                                Width="140"
                                                Height="95"
                                                Background="#CCB33C3C"
                                                Click="Delete_Click"
                                                Style="{StaticResource CircularButtonStyle}">
                                                <Icon:PackIconMaterial
                                                    Width="50"
                                                    Height="50"
                                                    Margin="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Kind="BackspaceOutline"
                                                    Style="{StaticResource menuButtonIcon}" />
                                            </Button>
                                            <Button
                                                Grid.Row="1"
                                                Width="140"
                                                Height="95"
                                                Background="#CC55B33C"
                                                Click="Login_Click"
                                                FontSize="18"
                                                Style="{StaticResource CircularButtonStyle}">
                                                <TextBlock
                                                    Margin="0"
                                                    HorizontalAlignment="Center"
                                                    FontSize="30"
                                                    Foreground="White"
                                                    Style="{StaticResource menuText}"
                                                    Text="Ввод" />
                                            </Button>
                                        </UniformGrid>

                                    </Grid>
                                </Grid>
                            </Border>
                            <Border
                                Grid.Row="1"
                                Grid.Column="0"
                                Width="1920"
                                Height="70"
                                Margin="0,0,0,38"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Background="#B6000000"
                                CornerRadius="0"
                                Style="{StaticResource whiteBorder}">
                                <Grid>
                                    <TextBlock
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Foreground="White"
                                        Style="{StaticResource menuText}"
                                        Text="Поддержка: 8 (800) 944 27 49" />
                                    <TextBlock
                                        Name="HardwareIDText"
                                        Margin="0,0,20,0"
